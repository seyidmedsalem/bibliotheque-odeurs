# Copier en .env puis changer les valeurs (le fichier .env n'est jamais publié sur GitHub)

# Mots de passe
DB_PASSWORD=nez-password
MQTT_USER=nez
MQTT_PASSWORD=change-moi
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
ADMIN_EMAIL=admin@nez.local
ADMIN_PASSWORD=admin1234
INGEST_KEY=dev-ingest-key

# Reconnaissance
CONFIDENCE_THRESHOLD=0.7
DETECTION_COOLDOWN_S=30

# Alertes par règles
MQ4_DANGER_VOLTS=2.5
VOC_WARNING_INDEX=400

# Telegram (optionnel) : créer un bot avec @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
